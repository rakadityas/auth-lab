{
  "realm": "authlab",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "realmRoles": ["default-roles-authlab"]
    }
  ],
  "clients": [
    {
      "clientId": "app-a",
      "name": "App A (OIDC Relying Party)",
      "enabled": true,
      "publicClient": false,
      "secret": "app-a-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:9000/callback"],
      "webOrigins": ["http://localhost:9000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9000/*",
        "backchannel.logout.url": "http://host.containers.internal:9000/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    },
    {
      "clientId": "app-b",
      "name": "App B (OIDC Relying Party)",
      "enabled": true,
      "publicClient": false,
      "secret": "app-b-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:9001/callback"],
      "webOrigins": ["http://localhost:9001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9001/*",
        "backchannel.logout.url": "http://host.containers.internal:9001/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    }
  ]
}
